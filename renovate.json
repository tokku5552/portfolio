{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor"],
  "automerge": true,
  "minimumReleaseAge": "7 days",
  "timezone": "Asia/Tokyo",
  "assignees": ["tokku5552"],
  "prConcurrentLimit": 5,
  "major": {
    "enabled": false
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  },
  "packageRules": [
    {
      "groupName": "linters",
      "extends": ["packages:linters"],
      "matchPackageNames": ["prettier", "@typescript-eslint/**"]
    },
    {
      "groupName": "jest",
      "matchPackageNames": ["jest", "jest-**"]
    },
    {
      "groupName": "react",
      "matchPackageNames": ["react", "react-dom", "react-**"]
    },
    {
      "description": "Allow major updates for ESLint core and Next's ESLint config so lint does not fall behind Next.js. Not automerged because majors usually need config changes.",
      "matchPackageNames": ["eslint", "eslint-config-next"],
      "matchUpdateTypes": ["major"],
      "enabled": true,
      "automerge": false
    }
  ]
}
