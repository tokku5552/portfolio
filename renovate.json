{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor"],
  "automerge": true,
  "minimumReleaseAge": "7 days",
  "timezone": "Asia/Tokyo",
  "assignees": ["tokku5552"],
  "prConcurrentLimit": 5,
  "major": {
    "enabled": false
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  },
  "packageRules": [
    {
      "groupName": "linters",
      "extends": ["packages:linters"],
      "matchPackageNames": ["prettier", "@typescript-eslint/**"]
    },
    {
      "groupName": "jest",
      "matchPackageNames": ["jest", "jest-**"]
    },
    {
      "groupName": "react",
      "matchPackageNames": ["react", "react-dom", "react-**"]
    },
    {
      "description": "Keep eslint-config-next in lockstep with next. Majors stay disabled for both (and for eslint); bump them together by hand when upgrading Next.js, since eslint-config-next 16 and ESLint 10 require Next 16.",
      "groupName": "next",
      "matchPackageNames": ["next", "eslint-config-next", "@next/**"]
    }
  ]
}
