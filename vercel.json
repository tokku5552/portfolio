{
  "github": {
    "enabled": true,
    "deployments": {
      "preview": {
        "enabled": true,
        "types": ["pull_request"]
      },
      "production": {
        "enabled": true
      }
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
